{
  "name": "arunaki-nexus",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web & npm run dev:desktop",
    "dev:app": "node scripts/dev-app.cjs",
    "start": "cargo run --release -p arunaki-engine --bin arunaki-engine",
    "dev:web": "npm run dev -w apps",
    "dev:desktop": "cargo run --release -p arunaki-engine --bin arunaki-engine",
    "build": "npm run build -w apps",
    "typecheck": "tsc -b apps/tsconfig.json",
    "test:unit": "cargo test --workspace",
    "test:smoke": "npx tsx scripts/smoke-local-cli.ts",
    "test:pos": "npx tsx scripts/test-pos-integration.ts",
    "test:knowledge": "npx tsx scripts/test-knowledge-e2e.ts",
    "bundle:prepare": "node scripts/prepare-bundle.cjs",
    "tauri": "npx @tauri-apps/cli",
    "tauri:dev": "npx @tauri-apps/cli dev",
    "tauri:build": "npm run build && npx @tauri-apps/cli build",
    "verify": "npm run build && npm run test:unit && npm run test:smoke"
  },
  "workspaces": [
    "apps"
  ],
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.61.1",
    "@remotion/bundler": "^4.0.540",
    "@remotion/renderer": "^4.0.540",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "iterare": "^1.2.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.10.0",
    "typescript": "~5.8.2"
  }
}
