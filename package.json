{
  "name": "aetheria-nexus",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web & npm run dev:desktop",
    "dev:app": "node scripts/dev-app.cjs",
    "start": "cargo run --release -p aetheria-engine --bin aetheria-engine",
    "dev:web": "npm run dev -w apps",
    "dev:desktop": "cargo run -p aetheria-engine --bin aetheria-engine",
    "dev:engine": "cargo run -p aetheria-engine --bin aetheria-engine -- serve",
    "build:engine": "cargo build -p aetheria-engine --bin aetheria-engine",
    "check:rs": "cargo check -p aetheria-engine",
    "build": "npm run build -w apps",
    "typecheck": "tsc -b apps/tsconfig.json",
    "test:unit": "cargo test --workspace",
    "test:engine": "cargo test -p aetheria-engine --lib",
    "test:e2e": "playwright test",
    "test:smoke": "npx tsx scripts/smoke-local-cli.ts",
    "test:knowledge": "npx tsx scripts/test-knowledge-e2e.ts",
    "test:parity": "node scripts/parity/run-conformance.mjs",
    "test:parity:golden": "node scripts/parity/record-golden.mjs",
    "test:parity:self": "node scripts/parity/self-test.mjs",
    "bundle:prepare": "node scripts/prepare-bundle.cjs",
    "tauri": "npx @tauri-apps/cli",
    "tauri:dev": "npx @tauri-apps/cli dev",
    "tauri:build": "npm run build && npx @tauri-apps/cli build",
    "verify": "npm run build && npm run test:unit && npm run test:smoke"
  },
  "workspaces": [
    "apps"
  ],
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.6.6",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "iterare": "^1.2.1",
    "pdf-lib": "^1.17.1",
    "typescript": "~5.8.2"
  }
}
