# GitHub Linguist Overrides
# Highlight actual engine & workstation source code (Rust backend + React/TypeScript UI)

# Documentation & Specifications
docs/** linguist-documentation
*.md linguist-documentation
*.txt linguist-documentation

# Test Suites & Fixtures (prevent test files from skewing code metrics)
**/*.test.ts linguist-vendored
**/*.test.tsx linguist-vendored
**/*.spec.ts linguist-vendored

# External Demo References & Generated Workspace Outputs
references/** linguist-vendored
workspace/** linguist-generated

# Vendored ArtCraft bundles ship Subresource Integrity hashes over their exact bytes.
# Any EOL conversion on checkout breaks SRI and the WASM app never boots.
apps/public/artcraft/** -text

# Detectable UI Styling & Markup
*.css linguist-detectable=true
*.html linguist-detectable=true

# Tooling Scripts as JavaScript
scripts/*.cjs linguist-language=JavaScript linguist-detectable=true
*.cjs linguist-language=JavaScript

# Shell & OS native automation
*.sh linguist-detectable=true
*.ps1 linguist-detectable=true
